/* 全局样式 */
page {
  background-color: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
}

.container {
  min-height: 100vh;
  padding-bottom: 100rpx;
}

/* 通用卡片样式 */
.card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #1E88E5 0%, #1565C0 100%);
  color: white;
  border-radius: 48rpx;
  border: none;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-secondary {
  background: white;
  color: #1E88E5;
  border: 2rpx solid #1E88E5;
  border-radius: 48rpx;
  padding: 22rpx 46rpx;
  font-size: 32rpx;
  font-weight: 500;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.tag-indoor {
  background: #E3F2FD;
  color: #1976D2;
}

.tag-outdoor {
  background: #E8F5E9;
  color: #388E3C;
}

.tag-level {
  background: #FFF3E0;
  color: #F57C00;
}

/* 文本样式 */
.text-primary {
  color: #1E88E5;
}

.text-secondary {
  color: #757575;
  font-size: 28rpx;
}

.text-price {
  color: #F44336;
  font-size: 36rpx;
  font-weight: bold;
}

/* 间距工具 */
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.ml-16 { margin-left: 16rpx; }
.mr-16 { margin-right: 16rpx; }

/* Flex布局 */
.flex {
  display: flex;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}
