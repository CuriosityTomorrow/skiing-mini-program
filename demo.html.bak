<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>滑雪场助手 - Demo预览（更新版）</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: #F5F5F5;
      max-width: 480px;
      margin: 0 auto;
      min-height: 100vh;
    }

    .phone-frame {
      background: white;
      min-height: 100vh;
      position: relative;
      padding-bottom: 80px;
    }

    .status-bar {
      background: linear-gradient(135deg, #1E88E5 0%, #1565C0 100%);
      padding: 12px 20px;
      color: white;
      font-size: 14px;
      display: flex;
      justify-content: space-between;
    }

    .nav-bar {
      background: #1E88E5;
      padding: 16px 20px;
      color: white;
      text-align: center;
      font-size: 18px;
      font-weight: 500;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .tab-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: white;
      display: flex;
      border-top: 1px solid #E0E0E0;
      max-width: 480px;
      margin: 0 auto;
    }

    .tab-item {
      flex: 1;
      text-align: center;
      padding: 10px 0;
      font-size: 12px;
      color: #666;
      cursor: pointer;
    }

    .tab-item.active {
      color: #1E88E5;
    }

    .tab-icon {
      font-size: 24px;
      margin-bottom: 4px;
    }

    /* 出发城市选择 */
    .departure-section {
      background: linear-gradient(135deg, #1E88E5 0%, #1565C0 100%);
      padding: 16px 20px;
    }

    .departure-label {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.9);
      margin-bottom: 8px;
    }

    .departure-input {
      width: 100%;
      padding: 12px 20px;
      border-radius: 24px;
      border: none;
      background: rgba(255, 255, 255, 0.2);
      color: white;
      font-size: 14px;
      outline: none;
    }

    .departure-input::placeholder {
      color: rgba(255, 255, 255, 0.6);
    }

    /* 搜索栏 */
    .search-bar {
      background: white;
      padding: 16px 20px;
    }

    .search-box {
      display: flex;
      align-items: center;
      background: #F5F5F5;
      border-radius: 24px;
      padding: 12px 20px;
    }

    .search-icon {
      margin-right: 10px;
      font-size: 16px;
    }

    .search-input {
      border: none;
      background: transparent;
      flex: 1;
      font-size: 14px;
      outline: none;
    }

    /* 筛选标签 */
    .filter-tags {
      display: flex;
      padding: 0 20px 12px;
      gap: 12px;
      background: white;
    }

    .filter-tag {
      padding: 8px 20px;
      background: #F5F5F5;
      border-radius: 20px;
      font-size: 13px;
      color: #666;
      cursor: pointer;
      border: none;
    }

    .filter-tag.active {
      background: #1E88E5;
      color: white;
    }

    /* 距离信息 */
    .location-info {
      padding: 12px 20px;
      background: #E8F5E9;
      font-size: 12px;
      color: #2E7D32;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .location-info.hint {
      background: #FFF3E0;
      color: #F57C00;
    }

    /* 滑雪场卡片 */
    .resort-card {
      background: white;
      margin: 16px 20px;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
      cursor: pointer;
    }

    .resort-image {
      width: 100%;
      height: 200px;
      object-fit: cover;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      position: relative;
    }

    .resort-info {
      padding: 16px;
    }

    .resort-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 12px;
    }

    .resort-name {
      font-size: 18px;
      font-weight: bold;
      color: #333;
    }

    .resort-rating {
      display: flex;
      align-items: center;
      color: #FF9800;
      font-size: 14px;
    }

    .resort-location {
      color: #757575;
      font-size: 13px;
      margin-bottom: 12px;
    }

    .resort-meta {
      display: flex;
      gap: 16px;
      font-size: 12px;
      color: #666;
      margin-bottom: 12px;
    }

    .resort-price {
      display: flex;
      align-items: baseline;
    }

    .price-value {
      font-size: 24px;
      color: #F44336;
      font-weight: bold;
    }

    .transport-info {
      background: #F5F5F5;
      padding: 12px;
      border-radius: 8px;
      margin-bottom: 12px;
    }

    .transport-title {
      font-size: 12px;
      color: #757575;
      margin-bottom: 8px;
    }

    .transport-item {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      margin-bottom: 6px;
    }

    .transport-type {
      color: #1E88E5;
      font-weight: 500;
    }

    /* 收藏按钮 */
    .collect-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      background: #FFF3E0;
      border-radius: 20px;
      font-size: 12px;
      color: #F57C00;
      cursor: pointer;
      border: none;
    }

    .collect-btn.collected {
      background: #FFEBEE;
      color: #C62828;
    }

    /* 页面容器 */
    .page {
      display: none;
    }

    .page.active {
      display: block;
    }

    /* 用户卡片 */
    .user-card {
      background: linear-gradient(135deg, #1E88E5 0%, #1565C0 100%);
      margin: 20px;
      border-radius: 16px;
      padding: 32px 24px;
      color: white;
    }

    /* 探索页面 */
    .section-tabs {
      display: flex;
      background: white;
      padding: 12px 0;
      margin-bottom: 16px;
    }

    .section-tab {
      flex: 1;
      text-align: center;
      padding: 12px;
      font-size: 14px;
      color: #666;
      cursor: pointer;
      border-bottom: 2px solid transparent;
    }

    .section-tab.active {
      color: #1E88E5;
      border-bottom-color: #1E88E5;
    }

    /* 评价卡片 */
    .review-card {
      background: white;
      margin: 0 20px 16px;
      border-radius: 12px;
      padding: 16px;
    }

    .review-user {
      display: flex;
      margin-bottom: 12px;
    }

    .review-avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      margin-right: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 20px;
    }

    .review-content {
      font-size: 14px;
      line-height: 1.6;
      color: #333;
      margin-bottom: 12px;
    }

    .review-scores {
      display: flex;
      justify-content: space-around;
      background: #F5F5F5;
      padding: 12px;
      border-radius: 8px;
      margin-bottom: 12px;
    }

    .score-item {
      text-align: center;
    }

    .score-value {
      display: block;
      font-size: 18px;
      color: #FF9800;
      font-weight: bold;
    }

    .score-label {
      font-size: 11px;
      color: #9E9E9E;
    }

    /* 搭子搜索栏 */
    .partner-search-bar {
      background: white;
      padding: 16px 20px;
      margin-bottom: 16px;
    }

    /* 搭子卡片 */
    .partner-card {
      background: white;
      margin: 0 20px 16px;
      border-radius: 12px;
      padding: 16px;
    }

    .matched-users {
      background: #E8F5E9;
      padding: 12px;
      border-radius: 8px;
      margin-top: 12px;
    }

    .matched-title {
      font-size: 12px;
      color: #2E7D32;
      margin-bottom: 8px;
    }

    .matched-user {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px;
      background: white;
      border-radius: 20px;
      margin-right: 8px;
    }

    .matched-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
    }

    .btn {
      padding: 10px 24px;
      border-radius: 24px;
      font-size: 14px;
      border: none;
      cursor: pointer;
    }

    .btn-primary {
      background: linear-gradient(135deg, #1E88E5 0%, #1565C0 100%);
      color: white;
    }

    .badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 12px;
      font-size: 11px;
      margin-right: 8px;
    }

    .badge-indoor {
      background: #E3F2FD;
      color: #1976D2;
    }

    .badge-outdoor {
      background: #E8F5E9;
      color: #388E3C;
    }
  </style>
</head>
<body>
  <div class="phone-frame">
    <!-- 状态栏 -->
    <div class="status-bar">
      <span>9:41</span>
      <span>📶 5G 🔋</span>
    </div>

    <!-- 导航栏 -->
    <div class="nav-bar" id="navTitle">搜索滑雪场</div>

    <!-- 页面1：搜索 -->
    <div class="page active" id="pageSearch">
      <div class="departure-section">
        <div class="departure-label">📍 出发城市</div>
        <input type="text" class="departure-input" placeholder="输入你的出发城市" id="departureInput">
      </div>

      <div class="search-bar">
        <div class="search-box">
          <span class="search-icon">🔍</span>
          <input type="text" class="search-input" placeholder="搜索目标城市或滑雪场" id="searchInput">
        </div>
      </div>

      <div class="filter-tags">
        <button class="filter-tag active" onclick="filterType('all')">全部</button>
        <button class="filter-tag" onclick="filterType('indoor')">室内</button>
        <button class="filter-tag" onclick="filterType('outdoor')">室外</button>
      </div>

      <div class="location-info hint" id="locationInfo">
        📍 请输入出发城市查看距离和交通方式
      </div>

      <div id="resortList"></div>
    </div>

    <!-- 页面2：探索 -->
    <div class="page" id="pageExplore">
      <div class="section-tabs">
        <div class="section-tab active" onclick="switchSection(0)">滑雪社区</div>
        <div class="section-tab" onclick="switchSection(1)">找搭子</div>
      </div>

      <div id="sectionContent"></div>
    </div>

    <!-- 页面3：我的 -->
    <div class="page" id="pageProfile">
      <div class="user-card">
        <div style="font-size: 48px; margin-bottom: 16px;">🎿</div>
        <div style="font-size: 24px; font-weight: bold;">滑雪爱好者</div>
        <div style="font-size: 12px; opacity: 0.8; margin-top: 8px;">点击完善个人信息</div>
        <div style="display: flex; margin-top: 24px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.2);">
          <div style="flex: 1; text-align: center;">
            <div style="font-size: 24px; font-weight: bold;">0</div>
            <div style="font-size: 12px; opacity: 0.8;">评价</div>
          </div>
          <div style="flex: 1; text-align: center;">
            <div style="font-size: 24px; font-weight: bold;">0</div>
            <div style="font-size: 12px; opacity: 0.8;">发起</div>
          </div>
          <div style="flex: 1; text-align: center;">
            <div style="font-size: 24px; font-weight: bold;">0</div>
            <div style="font-size: 12px; opacity: 0.8;">粉丝</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab栏 -->
    <div class="tab-bar">
      <div class="tab-item active" onclick="switchPage(0)">
        <div class="tab-icon">🔍</div>
        <div>搜索</div>
      </div>
      <div class="tab-item" onclick="switchPage(1)">
        <div class="tab-icon">🗺️</div>
        <div>探索</div>
      </div>
      <div class="tab-item" onclick="switchPage(2)">
        <div class="tab-icon">👤</div>
        <div>我的</div>
      </div>
    </div>
  </div>

  <script>
