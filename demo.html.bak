        transportation: [
          { type: '飞机', duration: '11小时', from: '北京', detail: '至里昂，转大巴2小时' }
        ]
      },
      {
        id: 14,
        name: '范尔滑雪场',
        city: '范尔',
        country: '美国',
        type: 'outdoor',
        price: 1350,
        priceUnit: '天',
        elevation: 3527,
        trails: 193,
        rating: 4.8,
        reviewCount: 9876,
        season: '11月-4月',
        latitude: 39.6403,
        longitude: -106.3742,
        transportation: [
          { type: '飞机', duration: '15小时', from: '北京', detail: '至丹佛，转大巴2小时' }
        ]
      },
      {
        id: 15,
        name: '惠斯勒黑梳山滑雪场',
        city: '惠斯勒',
        country: '加拿大',
        type: 'outdoor',
        price: 1180,
        priceUnit: '天',
        elevation: 2284,
        trails: 200,
        rating: 4.9,
        reviewCount: 8765,
        season: '11月-5月',
        latitude: 50.1155,
        longitude: -122.9542,
        transportation: [
          { type: '飞机', duration: '12小时', from: '北京', detail: '至温哥华，转大巴2小时' }
        ]
      }
    ];

    // 用户评价数据（带AI打分）
    const reviews = [
      {
        id: 1,
        user: { name: '雪霸天', type: '单板', level: '艺高人胆大', experience: '5个雪季' },
        resortId: 1,
        resortName: '万龙滑雪场',
        rating: 5,
        content: '万龙不愧是顶级雪场，雪质超好，中级道特别长！唯一的缺点就是周末人太多了，建议错峰去。附上我的滑雪视频，求大神指点！',
        aiScore: 4.8,
        avgScore: 4.7,
        date: '2025-01-15',
        mediaType: 'video'
      },
      {
        id: 2,
        user: { name: '小白爱滑雪', type: '双板', level: '小白', experience: '1个雪季' },
        resortId: 1,
        resortName: '万龙滑雪场',
        rating: 4,
        content: '第一次来万龙，作为小白有点害怕，教练很耐心。高级道太吓人了😅，还在魔毯区练习中。拍了照片记录一下！',
        aiScore: 4.2,
        avgScore: 4.3,
        date: '2025-01-10',
        mediaType: 'image'
      }
    ];

    // 搭子数据（带智能匹配）
    const partners = [
      {
        id: 1,
        user: { name: '北京单板小伙', type: '单板', level: '有点水平但不多', gender: '男', age: 26, location: '北京' },
        targetResort: '万龙滑雪场',
        plannedDate: '2025-02-15',
        description: '计划2月中旬去万龙刷2天，找个水平相当的小伙伴一起拍照拍视频！我可以开车去，AA油费过路费。',
        tags: ['可开车', '喜欢拍照', 'AA制'],
        matchedUsers: [
          { name: '滑雪达人', avatar: '🏂' },
          { name: '板仔小王', avatar: '🏂' }
        ]
      },
      {
        id: 2,
        user: { name: '双板小姐姐', type: '双板', level: '艺高人胆大', gender: '女', age: 24, location: '上海' },
        targetResort: '二世古滑雪场',
        plannedDate: '2025-03-10',
        description: '3月去二世古计划玩5天，找个女生搭子一起住酒店可以省点钱～我是双板，水平差不多的一起出发！',
        tags: ['女生专属', '可拼房', '日本行'],
        matchedUsers: [
          { name: '雪国少女', avatar: '🎿' }
        ]
      }
    ];

    let currentFilter = 'all';
    let currentSection = 0;
    let departureCity = '';
    let departureCityCoords = null;
    let searchKeyword = '';

    // 判断是否是滑雪场
    function isSkiResortByName(name) {
      if (!name) return { isSkiResort: false, confidence: 0, reason: '名称为空' };

      // 排除
      for (const keyword of EXCLUDE_KEYWORDS) {
        if (name.includes(keyword)) {
          return { isSkiResort: false, confidence: 0, reason: `排除：${keyword}` };
        }
      }

      // 匹配
      let matched = [];
      for (const keyword of SKI_RESORT_KEYWORDS) {
        if (name.toLowerCase().includes(keyword.toLowerCase())) {
          matched.push(keyword);
        }
      }

      if (matched.length > 0) {
        let confidence = 0.5;
        if (name.includes('滑雪场') || name.includes('滑雪中心')) confidence = 0.95;
        else if (name.includes('冰雪世界') || name.includes('热雪奇迹') || name.includes('乔波')) confidence = 0.85;
        else confidence = 0.6;

        return { isSkiResort: true, confidence: confidence, reason: `匹配：${matched.join(', ')}` };
      }

      return { isSkiResort: false, confidence: 0, reason: '无匹配关键词' };
    }

    // 计算两点间距离（米）
    function calculateDistance(lat1, lon1, lat2, lon2) {
      const R = 6371000;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLon = (lon2 - lon1) * Math.PI / 180;
      const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLon / 2) * Math.sin(dLon / 2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      return Math.round(R * c);
    }

    // 去重滑雪场（基于坐标距离）
    function deduplicateSkiResorts(pois) {
      const unique = [];

      for (const poi of pois) {
        let isDup = false;
        const [lon1, lat1] = poi.location.split(',').map(parseFloat);

        for (const existing of unique) {
          const [lon2, lat2] = existing.location.split(',').map(parseFloat);
          const dist = calculateDistance(lat1, lon1, lat2, lon2);

          if (dist < 100) {
            isDup = true;
            break;
          }
        }

        if (!isDup) unique.push(poi);
      }

      return unique;
    }

    // 从高德API搜索滑雪场
    async function searchSkiResortsFromAPI(city) {
      if (isLoading) return;
      isLoading = true;

      showLoading(true);

      try {
        const allPois = new Map();

        // 多关键词搜索
        for (const keyword of SKI_RESORT_KEYWORDS) {
          try {
            const url = `https://restapi.amap.com/v5/place/text?key=${API_KEY}&keywords=${encodeURIComponent(keyword)}&city=${city}&citylimit=true&offset=20&page=1&extensions=all`;
            const response = await fetch(url);
            const data = await response.json();

            if (data.pois) {
              data.pois.forEach(poi => allPois.set(poi.id, poi));
            }
          } catch (e) {
            console.warn(`关键词"${keyword}"失败:`, e);
          }
        }

        const poisArray = Array.from(allPois.values());

        // 智能筛选
        const filtered = [];
        for (const poi of poisArray) {
          const check = isSkiResortByName(poi.name);
          if (check.isSkiResort && check.confidence >= 0.5) {
            filtered.push(poi);
          }
        }

        // 去重
        const unique = deduplicateSkiResorts(filtered);

        // 转换为滑雪场格式
        resorts = unique.map(poi => {
          const [longitude, latitude] = poi.location.split(',').map(parseFloat);
          const type = poi.name && (poi.name.includes('室内') || poi.name.includes('融创') || poi.name.includes('乔波') || poi.name.includes('冰雪世界')) ? 'indoor' : 'outdoor';

          return {
            id: poi.id,
            name: poi.name,
            city: poi.cityname || poi.adname || city,
            country: '中国',
            type: type,
            price: type === 'indoor' ? 468 : 680,
            priceUnit: type === 'indoor' ? '4小时' : '天',
            elevation: 0,
            trails: 0,
            rating: 4.5,
            reviewCount: 0,
            season: type === 'indoor' ? '全年开放' : '11月-3月',
            latitude: latitude,
            longitude: longitude,
            address: poi.address || '',
            telephone: poi.tel || '',
            poi: poi
          };
        });

        console.log(`✅ 搜索完成：原始${poisArray.length}条 → 筛选${filtered.length}条 → 去重${unique.length}条`);
        showLoading(false);
        renderResorts();
      } catch (error) {
        console.error('搜索失败:', error);
        showLoading(false);
        alert('搜索失败：' + error.message);
      } finally {
        isLoading = false;
      }
    }

    // 显示/隐藏加载状态
    function showLoading(show) {
      const locationInfo = document.getElementById('locationInfo');
      if (show) {
        locationInfo.innerHTML = '⏳ 正在搜索附近的滑雪场...';
        locationInfo.classList.remove('hint');
      } else {
        locationInfo.innerHTML = '✅ 搜索完成';
      }
    }

    // 获取城市坐标（高德地理编码）
    async function getCityCoords(cityName) {
      try {
        const url = `https://restapi.amap.com/v3/geocode/geo?key=${API_KEY}&address=${encodeURIComponent(cityName)}`;
        const response = await fetch(url);
        const data = await response.json();

        if (data.geocodes && data.geocodes.length > 0) {
          const [longitude, latitude] = data.geocodes[0].location.split(',').map(parseFloat);
          return { latitude, longitude, city: data.geocodes[0].city };
        }
      } catch (error) {
        console.error('获取城市坐标失败:', error);
      }
      return null;
    }

    // 计算距离（公里）
    function calculateDistanceKm(lat1, lon1, lat2, lon2) {
      const dist = calculateDistance(lat1, lon1, lat2, lon2);
      return Math.round(dist / 1000);
    }

    // 渲染滑雪场列表
    function renderResorts() {
      const container = document.getElementById('resortList');
      let filtered = [...resorts];

      // 如果没有数据，显示提示
      if (filtered.length === 0) {
        container.innerHTML = `
          <div style="text-align: center; padding: 60px 20px; color: #9E9E9E;">
            <div style="font-size: 64px; margin-bottom: 16px;">🎿</div>
            <div style="font-size: 16px; color: #666; margin-bottom: 8px;">输入出发城市搜索附近的滑雪场</div>
            <div style="font-size: 12px;">支持：北京、上海、深圳、广州、哈尔滨等</div>
          </div>
        `;
        return;
      }

      // 1. 根据类型筛选
      if (currentFilter !== 'all') {
        filtered = filtered.filter(r => r.type === currentFilter);
      }

      // 2. 根据搜索关键词筛选
      if (searchKeyword) {
        filtered = filtered.filter(r =>
          r.city.toLowerCase().includes(searchKeyword) ||
          r.country.toLowerCase().includes(searchKeyword) ||
          r.name.toLowerCase().includes(searchKeyword)
        );
      }

      // 3. 如果有出发城市坐标，按距离排序
      if (departureCityCoords) {
        filtered = filtered.map(r => {
          if (r.latitude && r.longitude) {
            const distanceKm = calculateDistanceKm(
              departureCityCoords.latitude,
              departureCityCoords.longitude,
              r.latitude,
              r.longitude
            );
            return { ...r, distance: distanceKm };
          } else {
            return { ...r, distance: 999999 };
          }
        }).sort((a, b) => a.distance - b.distance);
      }

      // 4. 渲染结果
      if (filtered.length === 0) {
        container.innerHTML = '<div style="text-align: center; padding: 60px 20px; color: #9E9E9E;"><div style="font-size: 64px; margin-bottom: 16px;">🔍</div><div>没有找到相关滑雪场</div><div style="font-size: 12px; margin-top: 8px;">试试搜索其他城市或调整筛选条件</div></div>';
        return;
      }

      container.innerHTML = filtered.map(resort => `
        <div class="resort-card" onclick="showResortDetail(${resort.id})">
          <div class="resort-image" style="background: linear-gradient(135deg, ${getColor(resort.id)} 0%, ${getColor(resort.id + 1)} 100%);">
            <span style="position: absolute; top: 12px; left: 12px; padding: 6px 16px; border-radius: 16px; font-size: 11px; color: white; ${resort.type === 'indoor' ? 'background: rgba(33, 150, 243, 0.9);' : 'background: rgba(76, 175, 80, 0.9);'}">
              ${resort.type === 'indoor' ? '室内' : '室外'}
            </span>
            ${resort.distance ? `<span style="position: absolute; bottom: 12px; left: 12px; padding: 6px 16px; border-radius: 16px; font-size: 11px; color: white; background: rgba(0, 0, 0, 0.6);">📍 距你 ${resort.distance}km</span>` : ''}
          </div>
          <div class="resort-info">
            <div class="resort-header">
              <div class="resort-name">${resort.name}</div>
              <div class="resort-rating">
                <span class="star">⭐</span>
                ${resort.rating}
              </div>
            </div>
            <div class="resort-location">📍 ${resort.city}, ${resort.country}</div>
            <div class="resort-meta">
              <span>⛰️ 海拔 ${resort.elevation}m</span>
              <span>🎿 ${resort.trails}条雪道</span>
            </div>
            ${departureCity ? `
              <div class="transport-info">
                <div class="transport-title">🚗 从${departureCity}前往：</div>
                ${resort.transportation.map(t => `
                  <div class="transport-item">
                    <span class="transport-type">${t.type}</span>
                    <span>${t.duration}</span>
                  </div>
                `).join('')}
              </div>
            ` : ''}
            <div class="resort-price">
              <span class="price-value">¥${resort.price}</span>
              <span style="font-size: 12px; color: #9E9E9E;">/${resort.priceUnit}</span>
              <button class="collect-btn" style="margin-left: auto;" onclick="event.stopPropagation(); this.classList.toggle('collected');">
                <span>🤍</span> 收藏
              </button>
            </div>
          </div>
        </div>
      `).join('');
    }

    function getColor(id) {
      const colors = ['#667eea', '#764ba2', '#f093fb', '#4facfe', '#43e97b', '#fa709a', '#fee140'];
      return colors[id % colors.length];
    }

    function filterType(type) {
      currentFilter = type;
      document.querySelectorAll('.filter-tag').forEach((btn, index) => {
        const types = ['all', 'indoor', 'outdoor'];
        btn.classList.toggle('active', types[index] === type);
      });
      renderResorts();
    }

    function switchPage(index) {
      const pages = ['pageSearch', 'pageExplore', 'pageProfile'];
      const titles = ['搜索滑雪场', '探索', '我的'];

      document.querySelectorAll('.page').forEach((page, i) => {
        page.classList.toggle('active', i === index);
      });
      document.querySelectorAll('.tab-item').forEach((tab, i) => {
        tab.classList.toggle('active', i === index);
      });
      document.getElementById('navTitle').textContent = titles[index];

      if (index === 1) {
        renderSection();
      }
    }

    function switchSection(index) {
      currentSection = index;
      document.querySelectorAll('.section-tab').forEach((tab, i) => {
        tab.classList.toggle('active', i === index);
      });
      renderSection();
    }

    function renderSection() {
      const container = document.getElementById('sectionContent');

      if (currentSection === 0) {
        // 滑雪社区
        container.innerHTML = reviews.map(r => `
          <div class="review-card">
            <div class="review-user">
              <div class="review-avatar">${r.user.name[0]}</div>
              <div class="review-user-info">
                <div style="font-weight: 500;">${r.user.name}</div>
                <div style="font-size: 11px; color: #666;">${r.user.type} · ${r.user.level} · ${r.user.experience}</div>
              </div>
            </div>
            <div style="font-size: 12px; color: #1E88E5; margin-bottom: 8px;">🎿 ${r.resortName}</div>
            <div class="review-content">${r.content}</div>
            <div class="review-scores">
              <div class="score-item">
                <span class="score-value">🤖 ${r.aiScore}</span>
                <span class="score-label">AI评分</span>
              </div>
              <div class="score-item">
                <span class="score-value">⭐ ${r.avgScore}</span>
                <span class="score-label">网友评分</span>
              </div>
            </div>
            <div style="font-size: 12px; color: #9E9E9E; padding-top: 12px; border-top: 1px solid #F5F5F5;">
              ${r.date} · ${r.mediaType === 'video' ? '📹 视频' : '📷 图片'} · 👍 ${Math.floor(Math.random() * 500)}
            </div>
          </div>
        `).join('');
      } else {
        // 找搭子
        container.innerHTML = `
          <div class="partner-search-bar">
            <div class="search-box" style="margin-bottom: 12px;">
              <span class="search-icon">🔍</span>
              <input type="text" class="search-input" placeholder="搜索滑雪场、出发地">
            </div>
            <div class="filter-tags" style="padding: 0;">
              <button class="filter-tag active">最新</button>
              <button class="filter-tag">滑雪场</button>
              <button class="filter-tag">出发地</button>
            </div>
          </div>
          ${partners.map(p => `
            <div class="partner-card">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <div style="display: flex; align-items: center;">
                  <div class="review-avatar" style="width: 56px; height: 56px; font-size: 24px;">${p.user.name[0]}</div>
                  <div>
                    <div style="font-weight: 500;">${p.user.name}</div>
                    <div style="font-size: 12px; color: #666;">${p.user.gender} · ${p.user.age}岁 · ${p.user.type}</div>
                  </div>
                </div>
              </div>
              <div style="display: flex; gap: 16px; margin-bottom: 12px;">
                <div style="flex: 1; background: #F5F5F5; padding: 12px; border-radius: 8px;">
                  <div style="font-size: 11px; color: #9E9E9E; margin-bottom: 4px;">🎿 目标雪场</div>
                  <div style="font-size: 13px; font-weight: 500;">${p.targetResort}</div>
                </div>
                <div style="flex: 1; background: #F5F5F5; padding: 12px; border-radius: 8px;">
                  <div style="font-size: 11px; color: #9E9E9E; margin-bottom: 4px;">📅 计划日期</div>
                  <div style="font-size: 13px; font-weight: 500;">${p.plannedDate}</div>
                </div>
              </div>
              <div style="font-size: 14px; line-height: 1.6; margin-bottom: 12px;">${p.description}</div>
              <div style="display: flex; gap: 8px; margin-bottom: 12px;">
                ${p.tags.map(t => `<span class="badge badge-outdoor">${t}</span>`).join('')}
              </div>
              ${p.matchedUsers && p.matchedUsers.length > 0 ? `
                <div class="matched-users">
                  <div class="matched-title">💡 匹配到${p.matchedUsers.length}位行程相近的雪友</div>
                  ${p.matchedUsers.map(u => `
                    <div class="matched-user">
                      <span style="font-size: 24px;">${u.avatar}</span>
                      <span style="font-size: 12px;">${u.name}</span>
                    </div>
                  `).join('')}
                </div>
              ` : ''}
              <button class="btn btn-primary" style="width: 100%;">联系TA</button>
            </div>
          `).join('')}
        `;
      }
    }

    function showResortDetail(id) {
      const resort = resorts.find(r => r.id === id);
      if (!resort) return;

      alert(`🎿 ${resort.name}\n\n📍 ${resort.city}, ${resort.country}\n⭐ ${resort.rating} (${resort.reviewCount}条评价)\n💰 ¥${resort.price}/${resort.priceUnit}\n⛰️ 海拔 ${resort.elevation}m · ${resort.trails}条雪道\n📅 雪季：${resort.season}\n\n（完整功能请在微信开发者工具中查看）`);
    }

    // 出发城市输入 - 使用高德API
    let searchTimeout;
    document.getElementById('departureInput').addEventListener('input', async (e) => {
      const inputCity = e.target.value.trim();
      const locationInfo = document.getElementById('locationInfo');

      if (!inputCity) {
        departureCity = '';
        departureCityCoords = null;
        locationInfo.textContent = '📍 请输入出发城市查看距离和交通方式';
        locationInfo.classList.add('hint');
        renderResorts();
        return;
      }

      // 防抖：等待用户停止输入
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(async () => {
        locationInfo.textContent = `⏳ 正在搜索"${inputCity}"附近的滑雪场...`;
        locationInfo.classList.remove('hint');

        // 获取城市坐标
        const coords = await getCityCoords(inputCity);

        if (coords) {
          departureCityCoords = coords;
          locationInfo.textContent = `📍 从${coords.city || inputCity}出发，正在搜索滑雪场...`;

          // 搜索滑雪场
          await searchSkiResortsFromAPI(coords.city || inputCity);

          locationInfo.textContent = `📍 从${coords.city || inputCity}出发，找到${resorts.length}个滑雪场`;
        } else {
          locationInfo.textContent = `⚠️ 未找到"${inputCity}"，请检查城市名称`;
        }
      }, 500);
    });

    // 搜索功能
    document.getElementById('searchInput').addEventListener('input', (e) => {
      searchKeyword = e.target.value.toLowerCase().trim();
      renderResorts();
    });

    // 初始化
    renderResorts();
  </script>
</body>
</html>
