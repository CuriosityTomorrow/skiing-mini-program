/* pages/profile/profile.wxss */
.container {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 40rpx;
}

/* 用户卡片 */
.user-card {
  background: linear-gradient(135deg, #1E88E5 0%, #1565C0 100%);
  margin: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(30, 136, 229, 0.3);
}

.not-login {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.default-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  margin-bottom: 32rpx;
  padding: 8rpx;
}

.btn-login {
  background: white;
  color: #1E88E5;
  border-radius: 48rpx;
  padding: 24rpx 80rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  margin-bottom: 24rpx;
}

.login-hint {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 已登录状态 */
.user-info-wrapper {
  padding: 40rpx;
}

.user-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 40rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 24rpx;
}

.user-basic {
  flex: 1;
}

.user-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.user-nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  margin-right: 16rpx;
}

.user-badges {
  display: flex;
  gap: 8rpx;
}

.badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.25);
  color: white;
}

.user-location {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.location-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}

.edit-profile-btn {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 滑雪信息 */
.ski-info {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.info-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.info-row:first-child {
  padding-top: 0;
}

.info-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.info-value {
  font-size: 28rpx;
  color: white;
  font-weight: 500;
}

.ski-type-badge {
  background: rgba(255, 255, 255, 0.25);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

.level-badge {
  background: #FFF3E0;
  color: #F57C00;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

/* 统计数据 */
.user-stats {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 0;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stat-divider {
  width: 1rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* 菜单 */
.menu-section {
  background: white;
  margin: 0 24rpx 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.menu-text {
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  width: 32rpx;
  height: 32rpx;
}

/* 退出登录 */
.btn-logout {
  margin: 0 24rpx;
  background: white;
  color: #F44336;
  border-radius: 48rpx;
  padding: 28rpx;
  font-size: 32rpx;
  border: none;
}

/* 编辑资料弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.modal.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-content {
  width: 100%;
  max-height: 90vh;
  background: white;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s;
}

.modal.show .modal-content {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  padding: 8rpx;
}

.modal-body {
  flex: 1;
  padding: 32rpx;
  max-height: 60vh;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  padding: 24rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 性别选择器 */
.gender-selector {
  display: flex;
  gap: 24rpx;
}

.gender-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.3s;
}

.gender-option.active {
  background: #E3F2FD;
  border-color: #1E88E5;
}

.gender-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 12rpx;
}

.gender-option text {
  font-size: 28rpx;
  color: #333;
}

/* 滑雪类型选择器 */
.type-selector {
  display: flex;
  gap: 16rpx;
}

.type-option {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #666;
  border: 3rpx solid transparent;
  transition: all 0.3s;
}

.type-option.active {
  background: #E3F2FD;
  color: #1E88E5;
  border-color: #1E88E5;
  font-weight: 500;
}

/* 水平选择器 */
.level-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.level-option {
  width: calc(50% - 8rpx);
  padding: 24rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.3s;
}

.level-option.active {
  background: #FFF3E0;
  border-color: #FF9800;
}

.level-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.level-desc {
  display: block;
  font-size: 22rpx;
  color: #9E9E9E;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 32rpx;
  border-top: 1rpx solid #F5F5F5;
}

.btn-cancel, .btn-confirm {
  flex: 1;
  padding: 28rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  border: none;
}

.btn-cancel {
  background: #F5F5F5;
  color: #666;
}

.btn-confirm {
  background: linear-gradient(135deg, #1E88E5 0%, #1565C0 100%);
  color: white;
  font-weight: 500;
}
