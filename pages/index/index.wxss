/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 120rpx;
}

/* 出发城市选择 */
.departure-section {
  background: linear-gradient(135deg, #1E88E5 0%, #1565C0 100%);
  padding: 24rpx;
}

.departure-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 12rpx;
}

.departure-input-wrapper {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 48rpx;
  padding: 20rpx 32rpx;
  backdrop-filter: blur(10rpx);
}

.departure-input-wrapper .location-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.departure-input {
  flex: 1;
  font-size: 28rpx;
  color: white;
}

.departure-input::placeholder {
  color: rgba(255, 255, 255, 0.6);
}

.departure-input-wrapper .clear-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 搜索栏 */
.search-bar {
  background: white;
  padding: 24rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 48rpx;
  padding: 20rpx 32rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.clear-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
}

/* 筛选条件 */
.filter-bar {
  display: flex;
  background: white;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
}

.filter-item {
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  background: #F5F5F5;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.filter-item.active {
  background: #1E88E5;
  color: white;
}

/* 已选择栏 */
.selected-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  padding: 24rpx;
  margin: 0 24rpx 16rpx;
  border-radius: 16rpx;
}

.selected-count {
  font-size: 28rpx;
  color: #1565C0;
  font-weight: 500;
}

.selected-actions {
  display: flex;
  gap: 16rpx;
}

.btn-view-selected, .btn-compare {
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  border: none;
}

.btn-view-selected {
  background: white;
  color: #1E88E5;
}

.btn-compare {
  background: #1E88E5;
  color: white;
}

/* 位置信息 */
.location-info {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #E8F5E9;
}

.location-info-hint {
  background: #FFF3E0;
}

.location-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
}

.location-text {
  font-size: 26rpx;
  color: #2E7D32;
}

.location-info-hint .location-text {
  color: #F57C00;
}

/* 滑雪场列表 */
.resorts-list {
  padding: 0 24rpx;
}

.resort-card {
  display: flex;
  background: white;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.checkbox-wrapper {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 12rpx;
}

.checkbox-icon {
  width: 40rpx;
  height: 40rpx;
}

.resort-image-wrapper {
  position: relative;
  width: 240rpx;
  height: 280rpx;
  flex-shrink: 0;
}

.resort-image {
  width: 100%;
  height: 100%;
}

.resort-type-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: white;
}

.distance-tag {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.6);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
}

.distance-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}

.distance-tag text {
  font-size: 22rpx;
  color: white;
}

.resort-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
}

.resort-name-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.resort-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.rating-wrapper {
  display: flex;
  align-items: center;
}

.star-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.rating-text {
  font-size: 26rpx;
  color: #FF9800;
  font-weight: 500;
}

.resort-location {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.location-small-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}

.location-text-small {
  font-size: 26rpx;
  color: #757575;
}

.resort-details {
  display: flex;
  margin-bottom: 16rpx;
}

.detail-item {
  margin-right: 24rpx;
}

.detail-label {
  font-size: 24rpx;
  color: #9E9E9E;
  margin-right: 4rpx;
}

.detail-value {
  font-size: 26rpx;
  color: #333;
}

.transportation-info {
  background: #F5F5F5;
  padding: 12rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.transport-title {
  font-size: 24rpx;
  color: #757575;
  margin-right: 12rpx;
}

.transport-item {
  display: inline-block;
  margin-right: 16rpx;
  margin-bottom: 8rpx;
}

.transport-type {
  font-size: 24rpx;
  color: #1E88E5;
  font-weight: 500;
}

.transport-detail {
  font-size: 24rpx;
  color: #666;
}

.resort-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}

.price-wrapper {
  display: flex;
  align-items: baseline;
}

.price-label {
  font-size: 24rpx;
  color: #9E9E9E;
  margin-right: 8rpx;
}

.price-value {
  font-size: 36rpx;
  color: #F44336;
  font-weight: bold;
}

.price-unit {
  font-size: 24rpx;
  color: #9E9E9E;
}

.review-count {
  font-size: 24rpx;
  color: #9E9E9E;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #757575;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 28rpx;
  color: #9E9E9E;
}

/* 浮动对比按钮 */
.float-compare-btn {
  position: fixed;
  bottom: 120rpx;
  right: 32rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1E88E5 0%, #1565C0 100%);
  color: white;
  padding: 24rpx 32rpx;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 136, 229, 0.4);
  font-size: 28rpx;
  font-weight: 500;
  z-index: 999;
}

.float-compare-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}
